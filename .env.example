# ВериДок — пример конфигурации. Система МОДЕЛЬ-АГНОСТИЧНА: смена модели —
# это смена LLM_MODEL (и при необходимости LLM_BASE_URL), код пайплайна не меняется.

# --- LLM: любой OpenAI-совместимый эндпойнт (по умолчанию Ollama) ---
LLM_BASE_URL=http://localhost:11434/v1
# Дефолт — лучшая по оценке модель; альтернатива: hf.co/t-tech/T-lite-it-2.1-GGUF:latest
LLM_MODEL=qwen3-coder:30b
LLM_API_KEY=ollama
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1500
# Параллелизм независимых LLM-вызовов (extract/verify). На Apple Silicon выигрыш
# ограничен (GPU насыщается ~2 потоками).
LLM_CONCURRENCY=4

# --- Альтернатива: GigaChat 3 Lightning (open-weights) ---------------------
# Прогон выполняется ОДНОЙ сменой LLM_MODEL на тег вашего GigaChat-эндпойнта,
# поднятого по OpenAI-совместимому API (Ollama / llama.cpp server). Пример:
#   ollama pull <gigachat-3-lightning-gguf-tag>
#   затем:
# LLM_MODEL=gigachat3-lightning
# LLM_BASE_URL=http://localhost:11434/v1
# (или, если поднят llama.cpp server: LLM_BASE_URL=http://localhost:8080/v1)

# --- Эмбеддинги: та же модель Qwen3-Embedding-8B (dim 4096) -----------------
# backend=ollama — модель уже есть в Ollama (qwen3-embedding:8b);
# backend=sentence-transformers — локально на MPS (EMBED_MODEL=Qwen/Qwen3-Embedding-8B).
EMBED_BACKEND=ollama
EMBED_MODEL=qwen3-embedding:8b
EMBED_DIM=4096
EMBED_BASE_URL=http://localhost:11434/v1
# EMBED_DEVICE=mps   # для backend=sentence-transformers

# --- Qdrant: HTTP по URL ИЛИ embedded по QDRANT_PATH ---
QDRANT_URL=http://localhost:6333
# QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION=veridoc_sources

# --- Чанкинг и поиск ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
VERIFY_EVIDENCE_K=3
MAX_CLAIMS_PER_SEGMENT=12
SCORE_THRESHOLD=0.3
