# --- LLM: OpenAI-совместимый эндпойнт (любой локальный раннер) ---
LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=Qwen3.6-35B-A3B
LLM_API_KEY=not-needed
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1500

# --- Эмбеддинги (sentence-transformers, device=mps) ---
EMBED_MODEL=Qwen/Qwen3-Embedding-8B
EMBED_DIM=4096
EMBED_DEVICE=mps

# --- Qdrant: задайте QDRANT_URL для сервера ИЛИ QDRANT_PATH для embedded-режима ---
QDRANT_URL=http://localhost:6333
# QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION=veridoc_sources

# --- Чанкинг и поиск ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
MAX_CLAIMS_PER_SEGMENT=12
SCORE_THRESHOLD=0.3
